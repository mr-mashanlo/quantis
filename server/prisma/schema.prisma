generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  PHARMACIST
  NURSE
}

enum Type {
  CREDIT
  DEBIT
}

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  refreshToken String?
  expiredAt BigInt?
  employee Employee?
  @@index([refreshToken])
}

model Employee {
  id String @id @default(cuid())
  name String
  role Role @default(NURSE)
  user User @relation(fields: [userId], references: [id])
  userId String @unique
  createdAt DateTime @default(now())
  archived Boolean @default(false)
  patients Patient[]
  departments Department[]
  mediacations Medication[]
  transactions Transaction[]
  @@index([userId])
}

model Patient {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  employee Employee @relation(fields: [createdBy], references: [id])
  createdBy String
  archived Boolean @default(false)
  transactions Transaction[]
  @@index([createdBy])
}

model Department {
  id String @id @default(cuid())
  name String @unique
  createdAt DateTime @default(now())
  employee Employee @relation(fields: [createdBy], references: [id])
  createdBy String
  archived Boolean @default(false)
  transactions Transaction[]
  @@index([createdBy])
}

model Medication {
  id String @id @default(cuid())
  name String
  unit String
  createdAt DateTime @default(now())
  employee Employee @relation(fields: [createdBy], references: [id])
  createdBy String
  archived Boolean @default(false)
  transactions Transaction[]
  @@index([createdBy])
}

model Transaction {
  id String @id @default(cuid())
  operationId  String
  type Type
  amount Int
  createdAt DateTime @default(now())
  employee Employee @relation(fields: [createdBy], references: [id])
  createdBy String
  medication Medication @relation(fields: [medicationId], references: [id])
  medicationId String
  department Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  patient Patient? @relation(fields: [patientId], references: [id])
  patientId String?
  @@index([operationId])
  @@index([medicationId, departmentId])
}