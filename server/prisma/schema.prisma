generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  PHARMACIST
  NURSE
}

enum Type {
  CREDIT
  DEBIT
}

enum Status {
  DRAFT
  COMPLETED
  CANCELLED
}

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  refreshToken String?
  expiredAt BigInt?
  employee Employee?
  @@index([refreshToken])
}

model Employee {
  id String @id @default(cuid())
  name String
  role Role @default(NURSE)
  user User @relation(fields: [userId], references: [id])
  userId String @unique
  createdAt DateTime @default(now())
  archived Boolean @default(false)
  patients Patient[]
  departments Department[]
  mediacations Medication[]
  operations Operation[]
  transactions Transaction[]
  @@index([userId])
}

model Patient {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  createdBy Employee @relation(fields: [createdById], references: [id])
  createdById String
  archived Boolean @default(false)
  operations Operation[]
  @@index([createdById])
}

model Department {
  id String @id @default(cuid())
  name String @unique
  createdAt DateTime @default(now())
  createdBy Employee @relation(fields: [createdById], references: [id])
  createdById String
  archived Boolean @default(false)
  outgoingOperations Operation[] @relation("FromDepartment")
  incomingOperations Operation[] @relation("ToDepartment")
  @@index([createdById])
}

model Medication {
  id String @id @default(cuid())
  name String
  unit String
  createdAt DateTime @default(now())
  createdBy Employee @relation(fields: [createdById], references: [id])
  createdById String
  archived Boolean @default(false)
  transactions Transaction[]
  @@index([createdById])
}

model Operation {
  id String @id @default(cuid())
  status Status @default(DRAFT)
  fromDepartment Department @relation("FromDepartment", fields: [fromDepartmentId], references: [id])
  fromDepartmentId String
  toDepartment Department? @relation("ToDepartment", fields: [toDepartmentId], references: [id])
  toDepartmentId String?
  toPatient Patient? @relation(fields: [toPatientId], references: [id])
  toPatientId String?
  createdAt DateTime @default(now())
  createdBy Employee @relation(fields: [createdById], references: [id])
  createdById String
  transactions Transaction[]
  @@index([createdById])
}

model Transaction {
  id String @id @default(cuid())
  operation Operation @relation(fields: [operationId], references: [id])
  operationId String
  type Type
  medication Medication @relation(fields: [medicationId], references: [id])
  medicationId String
  amount Int
  createdAt DateTime @default(now())
  createdBy Employee @relation(fields: [createdById], references: [id])
  createdById String
  @@index([operationId])
  @@index([medicationId])
}